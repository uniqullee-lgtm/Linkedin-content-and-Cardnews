# ── Google Cloud 프로덕션 환경변수 예시 ────────────────────────────
# 실제 값은 Secret Manager에 저장하고 cloudbuild.yaml에서 --set-secrets로 주입합니다.

# Cloud SQL PostgreSQL 연결 (Cloud SQL Auth Proxy 방식)
# 형식: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://app_user:YOUR_PASSWORD@/linkedin_app?host=/cloudsql/YOUR_PROJECT:asia-northeast3:linkedin-db"

# Anthropic API 키 (Secret Manager 대신 직접 설정 시)
ANTHROPIC_API_KEY="sk-ant-..."

# Next.js
NODE_ENV="production"
NEXTAUTH_URL="https://YOUR-CLOUD-RUN-URL.run.app"
